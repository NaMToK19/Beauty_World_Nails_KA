---
// src/components/Hero.astro
---

<section id="start" class="relative bg-gradient-to-tr from-rose-50 to-amber-50 overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-20 lg:pt-40 lg:pb-32">
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-8 items-center">
      
      <div>
        <h1 class="text-5xl lg:text-6xl font-serif text-stone-900 leading-tight mb-6">
          Perfekte Nägel für deinen <span class="text-rose-600 italic">perfekten Auftritt.</span>
        </h1>
        <p class="text-lg text-stone-600 mb-8 max-w-lg leading-relaxed">
          Entspanne dich in unserem exklusiven Nagelstudio in Karlsruhe. Wir nehmen uns Zeit für deine Schönheit und verwenden nur hochwertige Produkte für langanhaltende, makellose Ergebnisse.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#termine" class="inline-flex justify-center items-center bg-stone-900 hover:bg-rose-700 text-white px-8 py-3.5 rounded-full text-base font-medium transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5">
            Termin anfragen
          </a>
          <a href="#preise" class="inline-flex justify-center items-center bg-white hover:bg-stone-50 text-stone-800 border border-stone-200 px-8 py-3.5 rounded-full text-base font-medium transition-all shadow-sm">
            Preise ansehen
          </a>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-md lg:max-w-none mt-10 lg:mt-0">
        <div class="absolute inset-0 bg-rose-300 rounded-full blur-3xl opacity-40 transform translate-x-10 translate-y-10"></div>
        
        <img 
          src="https://images.unsplash.com/photo-1519014816548-bf5fe059e98b?auto=format&fit=crop&q=80&w=1000" 
          alt="Elegante Maniküre im Beauty World Nails" 
          class="relative rounded-2xl shadow-2xl object-cover w-full h-[400px] lg:h-[550px] border-4 border-white"
        />
      </div>

    </div>
  </div>
</section>