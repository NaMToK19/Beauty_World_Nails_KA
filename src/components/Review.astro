---
// src/components/Reviews.astro

// Deine saubere Datenstruktur für die besten Bewertungen
const reviews = [
  {
    name: "Sarah M.",
    date: "vor 2 Monaten",
    text: "Das beste Nagelstudio in Karlsruhe! Ich bin seit über einem Jahr Stammkundin und meine Nägel (Neumodellage mit Gel) halten bombenfest und sehen jedes Mal exakt so aus, wie ich es mir gewünscht habe. Das Team ist super freundlich und arbeitet extrem hygienisch.",
    rating: 5
  },
  {
    name: "Julia K.",
    date: "vor 3 Wochen",
    text: "Ich war spontan zur Pediküre mit Shellac dort. Sehr schönes, sauberes Ambiente. Man nimmt sich wirklich Zeit für die Kunden. Preis-Leistungs-Verhältnis ist top. Ich komme definitiv wieder!",
    rating: 5
  },
  {
    name: "Elena R.",
    date: "vor einem Monat",
    text: "Endlich ein Studio, das meine Wünsche genau umsetzt. Die Handmalerei ist wunderschön geworden. Außerdem gibt es keine langen Wartezeiten, wenn man einen Termin hat. Absolute Empfehlung!",
    rating: 5
  }
];
---

<section id="bewertungen" class="py-24 bg-stone-50 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-16">
      <h2 class="text-4xl font-serif text-stone-900 mb-4">Das sagen <span class="text-rose-600 italic">unsere Kundinnen</span></h2>
      <p class="text-stone-600 max-w-xl mx-auto">Qualität, die für sich spricht. Wir freuen uns über das großartige Feedback.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {reviews.map((review) => (
        <div class="bg-white rounded-3xl p-8 shadow-sm border border-stone-100 relative">
          
          <div class="absolute top-6 right-8 opacity-20">
            <svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
          </div>

          <div class="flex gap-1 mb-4">
            {[...Array(review.rating)].map(() => (
              <svg class="w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>

          <p class="text-stone-700 mb-6 italic leading-relaxed">"{review.text}"</p>
          
          <div class="flex items-center gap-3 mt-auto">
            <div class="w-10 h-10 bg-rose-100 text-rose-700 rounded-full flex items-center justify-center font-bold text-sm">
              {review.name.charAt(0)}
            </div>
            <div>
              <p class="font-bold text-stone-900 text-sm">{review.name}</p>
              <p class="text-xs text-stone-500">{review.date}</p>
            </div>
          </div>

        </div>
      ))}
    </div>

    <div class="mt-16 text-center">
      <a href="https://maps.google.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-white hover:bg-stone-50 text-stone-800 border border-stone-200 px-6 py-3 rounded-full text-sm font-medium transition-all shadow-sm">
        <svg class="w-5 h-5 text-blue-500" viewBox="0 0 24 24" fill="currentColor">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        Alle Rezensionen auf Google lesen
      </a>
    </div>

  </div>
</section>