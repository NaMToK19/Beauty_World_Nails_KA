---
// src/components/Navbar.astro
const links = [
  { name: 'Start', url: '#start' },
  { name: 'Preise', url: '#preise' },
  { name: 'Galerie', url: '#galerie' },
  { name: 'Bewertungen', url: '#bewertungen' },
  { name: 'Kontakt', url: '#kontakt' },
];
---

<header class="fixed top-0 z-50 w-full bg-white/80 backdrop-blur-md border-b border-stone-200 shadow-sm">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      
      <div class="flex-shrink-0 flex items-center">
        <a href="#" class="font-serif text-2xl text-rose-700 font-bold tracking-wider">Beauty World Nails</a>
      </div>

      <nav class="hidden md:flex space-x-8">
        {links.map((link) => (
          <a href={link.url} class="text-stone-600 hover:text-rose-600 px-3 py-2 text-sm font-medium transition-colors">
            {link.name}
          </a>
        ))}
      </nav>

      <div class="hidden md:flex items-center">
        <a href="#termine" class="bg-stone-900 hover:bg-rose-700 text-white px-6 py-2.5 rounded-full text-sm font-medium transition-all shadow-md">
          Termin buchen
        </a>
      </div>

      <div class="flex items-center md:hidden">
        <button type="button" id="mobile-menu-button" class="text-stone-600 hover:text-rose-600 focus:outline-none p-2">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
      
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-stone-100 absolute w-full shadow-lg">
    <div class="px-4 pt-2 pb-6 space-y-2 shadow-2xl">
      {links.map((link) => (
        <a href={link.url} class="block px-3 py-3 rounded-md text-base font-medium text-stone-700 hover:text-rose-600 hover:bg-rose-50">
          {link.name}
        </a>
      ))}
      <a href="#termine" class="block w-full text-center mt-4 bg-stone-900 text-white px-5 py-3 rounded-md text-base font-medium hover:bg-rose-700 transition-colors">
        Termin buchen
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');

  // Menü umschalten
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  // Menü automatisch schließen, wenn man auf dem Handy einen Link anklickt
  const mobileLinks = menu?.querySelectorAll('a');
  mobileLinks?.forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
    });
  });
</script>