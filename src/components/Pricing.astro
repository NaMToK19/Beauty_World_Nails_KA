---
// src/components/Pricing.astro

// Typisierung für die Preisliste (optional in Astro, aber extrem hilfreich für Entwickler)
type PriceItem = {
  name: string;
  price: string;
  note?: string; // Für Dinge wie "pro Nagel"
  isFrom?: boolean; // Für Preise mit "ab X €"
};

type PriceCategory = {
  category: string;
  description?: string;
  items: PriceItem[];
};

// Die Datenstruktur - absolut pflegeleicht für die Zukunft!
const pricingData: PriceCategory[] = [
  {
    category: "Maniküre",
    items: [
      { name: "Basic Maniküre", price: "18 €" }, // Korrigiert! Auf der alten Seite stand hier Pediküre
      { name: "Maniküre mit Farbe (Nagellack)", price: "28 €" },
      { name: "Maniküre mit Shellac", price: "38 €" },
    ]
  },
  {
    category: "Pediküre",
    items: [
      { name: "Basic Pediküre", price: "35 €" },
      { name: "Basic Shellac", price: "30 €" },
      { name: "Shellac mit French", price: "40 €" },
      { name: "Pediküre mit Farbe", price: "45 €" },
      { name: "Pediküre mit French", price: "55 €" },
      { name: "Pediküre mit Pulver & Farbe", price: "55 €" },
      { name: "Pediküre mit Pulver & French", price: "65 €" },
    ]
  },
  {
    category: "Neumodellage & Auffüllen",
    description: "Pulver oder UV Gel",
    items: [
      { name: "Natur", price: "35 €" },
      { name: "Farbe / French / Verlauf", price: "40 €" },
      { name: "Besonderes French mit Handmalerei", price: "45 €" },
      { name: "Natur mit Chrome oder Cat Eye", price: "45 €" },
      { name: "Farbe mit Chrome oder Cat Eye", price: "48 €" },
      { name: "3D, 4D Blume", price: "5 €", isFrom: true },
      { name: "Strassstein", price: "0,50 €", isFrom: true },
      { name: "Handmalerei", price: "2 €", isFrom: true, note: "pro Nagel" },
      { name: "Ablösen & Neumodellage", price: "5 €", isFrom: true },
      { name: "Extra lange Nägel", price: "3 €", isFrom: true },
    ]
  },
  {
    category: "Ablösen",
    items: [
      { name: "Ablösen", price: "15 €" },
      { name: "Ablösen mit Maniküre", price: "30 €" },
      { name: "Ablösen mit Shellac", price: "35 €" },
    ]
  },
  {
    category: "Wimpern",
    items: [
      { name: "1:1 Einzelverlängerung", price: "70 €" },
      { name: "Volume 3D / 6D", price: "90 €" },
      { name: "Auffüllen nach 2 Wochen", price: "60 €" },
    ]
  }
];
---

<section id="preise" class="py-24 bg-white relative">
  <div class="absolute top-0 left-0 w-full h-full overflow-hidden z-0 pointer-events-none">
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-rose-50 rounded-full blur-3xl opacity-50"></div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-serif text-stone-900 mb-4">Unsere <span class="text-rose-600 italic">Preise</span></h2>
      <p class="text-stone-600 max-w-xl mx-auto">Transparente Preise für deinen perfekten Look. Hochwertige Behandlungen zum fairen Preis.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 items-start">
      {pricingData.map((category) => (
        <div class="bg-stone-50/80 backdrop-blur-sm rounded-3xl p-8 shadow-sm border border-stone-200 hover:shadow-md transition-shadow">
          
          <div class="mb-6 border-b border-rose-200/60 pb-4">
            <h3 class="text-2xl font-serif text-stone-900">{category.category}</h3>
            {category.description && (
              <p class="text-xs text-rose-600 mt-1 uppercase tracking-wider font-semibold">{category.description}</p>
            )}
          </div>
          
          <ul class="space-y-4">
            {category.items.map((item) => (
              <li class="flex justify-between items-end group">
                <div class="flex-1">
                  <span class="text-stone-800 font-medium">{item.name}</span>
                  {item.note && (
                    <span class="block text-xs text-stone-500 mt-0.5">{item.note}</span>
                  )}
                </div>
                
                <div class="flex-grow border-b-2 border-dotted border-stone-300 mx-4 mb-2 opacity-30 group-hover:opacity-100 transition-opacity"></div>
                
                <div class="text-rose-700 font-semibold whitespace-nowrap text-right">
                  {item.isFrom && <span class="text-xs text-stone-500 font-normal mr-1">ab</span>}
                  {item.price}
                </div>
              </li>
            ))}
          </ul>

        </div>
      ))}
    </div>
    
  </div>
</section>